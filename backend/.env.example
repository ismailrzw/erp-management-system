FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
MONGO_URI=mongodb://localhost:27017/pbl_system
JWT_SECRET_KEY=dev-jwt-secret-key-32-chars-long-secure-key
JWT_EXPIRATION_HOURS=8

# ── Email Infrastructure Configuration ──────────────────────────────
# MAIL_PROVIDER options: 'smtp' or 'sendgrid'.
# If not configured, outgoing emails are safely logged to console in dev mode.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=PBL Portal - BNU
MAIL_FROM_ADDRESS=noreply@bnu.edu.pk
FRONTEND_URL=http://localhost:5173

# SendGrid (optional, if MAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
